# Quick sanity checks — run with `python proposed_new_operators.py`:

if __name__ == "__main__":
    np.random.seed(0)

    # -- shape test --
    arr = np.random.randn(2, 5, 10)  # 2 days, 5 stocks, 10 bars
    sk = step_skewness(arr)
    ku = step_kurtosis(arr)
    assert sk.shape == (2, 5, 1), f"step_skewness shape wrong: {sk.shape}"
    assert ku.shape == (2, 5, 1), f"step_kurtosis shape wrong: {ku.shape}"

    # -- value test (1 stock, 1 day) vs the SQL reference formula --
    single = arr[0, 0, :]
    n = len(single)
    mean = single.mean()
    demeaned = single - mean
    m3 = (demeaned ** 3).sum()
    m2 = (demeaned ** 2).sum()
    m4 = (demeaned ** 4).sum()

    # HfReturnSkew SQL formula:
    expected_sk = (n * np.sqrt(n - 1) / (n - 2)) * m3 / (m2 ** 1.5)
    # HfReturnKurt SQL formula:
    c1 = n * (n + 1) * (n - 1) / ((n - 2) * (n - 3))
    c2 = 3 * (n - 1) ** 2 / ((n - 2) * (n - 3))
    expected_ku = c1 * m4 / (m2 ** 2) - c2

    got_sk = float(sk[0, 0, 0])
    got_ku = float(ku[0, 0, 0])
    assert abs(got_sk - expected_sk) < 1e-10, f"skewness {got_sk} != {expected_sk}"
    assert abs(got_ku - expected_ku) < 1e-10, f"kurtosis {got_ku} != {expected_ku}"

    # -- NaN bar handling --
    arr_nan = arr.copy()
    arr_nan[0, 0, 3:7] = np.nan  # mask out 4 bars → 6 left
    sk_nan = step_skewness(arr_nan)
    assert not np.isnan(sk_nan[0, 0, 0]), "skewness should handle partial NaN"
    arr_too_few = arr.copy()
    arr_too_few[0, 0, 2:] = np.nan  # only 2 bars → should be NaN
    sk_few = step_skewness(arr_too_few)
    assert np.isnan(sk_few[0, 0, 0]), "skewness with <3 bars should be NaN"

    # -- cs_rank test --
    # 1 date, 5 stocks, 1 bar
    rank_in = np.array([[[3.0], [1.0], [4.0], [2.0], [5.0]]]).reshape(1, 5, 1)
    r = cs_rank(rank_in)
    assert r.shape == (1, 5, 1)
    assert np.array_equal(r[0, :, 0], [3.0, 1.0, 4.0, 2.0, 5.0]), \
        f"ordinal ranks wrong: {r[0, :, 0]}"
    rp = cs_rank(rank_in, pct=True)
    assert np.allclose(rp[0, :, 0], [0.6, 0.2, 0.8, 0.4, 1.0]), \
        f"percentile ranks wrong: {rp[0, :, 0]}"

    # -- cs_rank with NaN --
    rank_nan = rank_in.copy()
    rank_nan[0, 2, 0] = np.nan
    rn = cs_rank(rank_nan, pct=True)
    # 4 valid stocks → percentile ranks ∈ {0.25, 0.5, 0.75, 1.0}
    assert np.isnan(rn[0, 2, 0]), "NaN position should stay NaN"
    rn_valid = rn[0, np.array([True, True, False, True, True]), 0]
    assert np.allclose(np.sort(rn_valid), [0.25, 0.5, 0.75, 1.0]), \
        f"NaN pct rank wrong: {rn[0, :, 0]}"

    print("All tests passed.")
    print(f"  step_skewness[0,0,0]: {got_sk:.6f} (expected SQL formula: {expected_sk:.6f})")
    print(f"  step_kurtosis[0,0,0]: {got_ku:.6f} (expected SQL formula: {expected_ku:.6f})")
