# =======================================================================
# 2. CROSS-SECTIONAL OPERATOR
# =======================================================================

# cs_rank(x, pct=False, method='ordinal')
#
# Ranks stocks along the *asset* axis at each (date, step).
# Default returns integer ranks; pct=True returns percentile ranks in [0, 1]
# (matching pandas .rank(pct=True)).
#
# This matches what the standalone PATV core does:
#     data.groupby("start_time").apply(lambda df: df["atv"].rank(method="dense", pct=True))
#
# i.e., rank the cross-sectional distribution of abnormal turnover volume
# *within* each intraday bar.
# ---------------------------------------------------------------------
_CS_RANK_METHODS = {"ordinal", "min", "max", "dense"}


def cs_rank(x, pct=False, method: str = "ordinal"):
    """Cross-sectional rank along the asset axis.

    Parameters
    ----------
    x : array-like, shape (n_dates, n_assets, n_steps)
    pct : bool
        If True, divide ranks by the number of non-NaN assets in that
        slice, yielding a percentile rank in [0, 1].
    method : {"ordinal", "min", "max", "dense"}
        Tie-handling method; see `scipy.stats.rankdata`.
    """
    if method not in _CS_RANK_METHODS:
        raise ValueError(f"cs_rank method must be one of {_CS_RANK_METHODS}, got {method!r}")

    arr = ensure_3d(x).astype(float)
    n_dates, n_assets, n_steps = arr.shape
    out = np.full_like(arr, np.nan)

    for t in range(n_dates):
        for s in range(n_steps):
            col = arr[t, :, s]
            valid = ~np.isnan(col)
            n_valid = valid.sum()
            if n_valid == 0:
                continue
            ranks = rankdata(col[valid], method=method)
            if pct:
                ranks = ranks / n_valid
            out[t, valid, s] = ranks

    return out


