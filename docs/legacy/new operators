# ---------------------------------------------------------------------
# step_skewness(x) — sample skewness along the step axis
#
# Uses the Fisher (bias-corrected) definition:
#   skew = [ n / ((n-1)(n-2)) ] * sum( ((x - mean) / std)^3 )
#
# Minimum 3 non-NaN bars required per (date, stock); otherwise NaN.
# ---------------------------------------------------------------------
def step_skewness(x):
    """Sample skewness along the step axis (3rd moment).

    Matches the SQL reference used by HfReturnSkew standalone (core.py):

        sum( N * sqrt(N-1) / (N-2) * r_demean^3 ) / sum( r_demean^2 )^1.5
    """
    arr = ensure_3d(x).astype(float)
    mean = np.nanmean(arr, axis=2, keepdims=True)
    demeaned = arr - mean
    n = np.sum(~np.isnan(arr), axis=2, keepdims=True)

    with np.errstate(invalid="ignore", divide="ignore"):
        coef = n * np.sqrt(n - 1) / (n - 2)
        m3 = np.nansum(demeaned ** 3, axis=2, keepdims=True)
        m2 = np.nansum(demeaned ** 2, axis=2, keepdims=True)
        skew = coef * m3 / (m2 ** 1.5)
    skew = np.where(n >= 3, skew, np.nan)
    return skew


# ---------------------------------------------------------------------
# step_kurtosis(x) — excess kurtosis along the step axis (4th moment,
# N-bias-corrected).
#
# This matches the exact formula used by the SQL reference
# (Signal_HfReturnKurt/core.py):
#
#   kurt_d =
#       avg( N*(N+1)*(N-1) / ((N-2)*(N-3)) )
#         * sum( r_demean^4 ) / sum( r_demean^2 )^2
#       - avg( 3*(N-1)^2 / ((N-2)*(N-3)) )
#
# which simplifies to the standard excess-kurtosis estimator:
#
#   kurt_excess = [ n*(n+1) / ((n-1)*(n-2)*(n-3)) ] * sum(d^4) / var^2
#                 - 3*(n-1)^2 / ((n-2)*(n-3))
#
# Minimum 4 non-NaN bars required; otherwise NaN.
# ---------------------------------------------------------------------
def step_kurtosis(x):
    """Excess kurtosis along the step axis (4th moment, N-bias corrected).

    Matches the SQL reference for HfReturnKurt exactly (see standalone
    core.py).
    """
    arr = ensure_3d(x).astype(float)
    mean = np.nanmean(arr, axis=2, keepdims=True)
    demeaned = arr - mean
    n = np.sum(~np.isnan(arr), axis=2, keepdims=True)

    m4 = np.nansum(demeaned ** 4, axis=2, keepdims=True)
    m2 = np.nansum(demeaned ** 2, axis=2, keepdims=True)

    with np.errstate(invalid="ignore", divide="ignore"):
        coef1 = (n * (n + 1) * (n - 1)) / ((n - 2) * (n - 3))
        coef2 = (3 * (n - 1) ** 2) / ((n - 2) * (n - 3))
        kurt = coef1 * m4 / (m2 ** 2) - coef2
    kurt = np.where(n >= 4, kurt, np.nan)
    return kurt


