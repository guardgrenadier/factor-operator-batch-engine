{
  "schema_version": 3,
  "datasets": [
    {
      "dataset_id": "stk_return_daily",
      "reader": "sql_reader",
      "query_builder": "panel_fields",
      "asset": "stk",
      "freq": "1d",
      "table": "SmartQuant.ReturnDaily",
      "date_col": "DataDate",
      "code_col": "InnerCode",
      "trading_flag_col": "IfTradingDay",
      "asset_axis": true
    },
    {
      "dataset_id": "cb_return_daily",
      "reader": "sql_reader",
      "query_builder": "panel_fields",
      "asset": "cb",
      "freq": "1d",
      "table": "SmartQuant.CBReturnDaily",
      "date_col": "DataDate",
      "code_col": "InnerCode",
      "trading_flag_col": "IfTradingDay",
      "asset_axis": true
    },
    {
      "dataset_id": "idx_quote",
      "reader": "sql_reader",
      "query_builder": "panel_fields",
      "asset": "idx",
      "freq": "1d",
      "table": "JYDB.QT_IndexQuote",
      "date_col": "TradingDay",
      "code_col": "InnerCode",
      "asset_axis": true
    },
    {
      "dataset_id": "stk_1min",
      "reader": "parquet_bars",
      "asset": "stk",
      "freq": "1min",
      "path_template": "/data/cephfs/minute/one_minute_stat/{date}.parquet",
      "code_map": {
        "mode": "static",
        "table": "SmartQuant.InnerCode_SecuCode"
      }
    },
    {
      "dataset_id": "cb_1min",
      "reader": "parquet_bars",
      "asset": "cb",
      "freq": "1min",
      "path_template": "/data/cephfs/cb_minute/one_minute_stat/{date}.parquet",
      "code_map": {
        "mode": "dated",
        "dataset_id": "cb_return_daily"
      }
    },
    {
      "dataset_id": "stk_5min",
      "reader": "parquet_bars",
      "asset": "stk",
      "freq": "5min",
      "path_template": "/data/cephfs/minute/five_minute/{date}.parquet",
      "code_map": {
        "mode": "static",
        "table": "SmartQuant.InnerCode_SecuCode"
      }
    },
    {
      "dataset_id": "stk_adjust_factor",
      "reader": "sql_reader",
      "query_builder": "adjust_factor",
      "asset": "stk",
      "freq": "1d",
      "anchor_dataset_id": "stk_return_daily",
      "factor_table": "JYDB.DZ_AdjustingFactor"
    },
    {
      "dataset_id": "stk_untradable",
      "reader": "sql_reader",
      "query_builder": "untradable",
      "asset": "stk",
      "freq": "1d",
      "table": "SmartQuant.Untradable",
      "date_col": "DataDate",
      "code_col": "InnerCode"
    },
    {
      "dataset_id": "cb_stock_map",
      "reader": "cb_stock_map",
      "asset": "cb",
      "freq": "1d",
      "bond_code_table": "JYDB.Bond_Code",
      "relation_table": "JYDB.Bond_ConBDBasicInfo"
    },
    {
      "dataset_id": "stk_index_component",
      "reader": "sql_reader",
      "query_builder": "panel_fields",
      "asset": "stk",
      "freq": "1d",
      "table": "SmartQuant.IndexComponentWeight_Choice",
      "date_col": "EndDate",
      "code_col": "SecuInnerCode",
      "selector": {
        "param": "index_inner_code",
        "column": "IndexInnerCode",
        "type": "integer"
      },
      "discover_fields": false
    }
  ],
  "sources": {
    "stk.1d.adj_factor": {
      "dataset_id": "stk_adjust_factor"
    },
    "stk.1d.is_untradable": {
      "dataset_id": "stk_untradable",
      "value_kind": "mask",
      "default": 0
    },
    "cb.1d.underlying_stk_col": {
      "dataset_id": "cb_stock_map",
      "projection": "axis_position",
      "value_kind": "code",
      "params": {
        "target_asset": "stk"
      }
    },
    "cb.1d.underlying_stk_inner_code": {
      "dataset_id": "cb_stock_map",
      "projection": "inner_code",
      "value_kind": "code"
    },
    "stk.1d.industry_code.SW2021.L1": {
      "dataset_id": "stk_return_daily",
      "field": "IndustryCodeNew",
      "value_kind": "code"
    },
    "stk.1d.index_weight.CSI300": {
      "dataset_id": "stk_index_component",
      "field": "Weight",
      "params": {
        "index_inner_code": 3145
      }
    },
    "stk.1d.is_member.CSI300": {
      "dataset_id": "stk_index_component",
      "constant": 1,
      "default": 0,
      "value_kind": "mask",
      "params": {
        "index_inner_code": 3145
      }
    }
  }
}
